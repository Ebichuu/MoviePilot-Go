MOVIEPILOT_ENV=development
# 必须使用 GitHub Actions 候选清单或正式发布说明记录的完整 digest。
MOVIEPILOT_IMAGE=ghcr.io/owner/repository/moviepilot-go@sha256:replace-with-verified-digest
MOVIEPILOT_SOURCE_SHA=replace-with-40-character-candidate-source-sha
MOVIEPILOT_HTTP_ADDR=:3000
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password
MOVIEPILOT_DATABASE_URL=postgres://moviepilot:replace-with-a-long-url-safe-random-password@postgres:5432/moviepilot?sslmode=disable
MOVIEPILOT_REDIS_URL=redis://redis:6379/0
MOVIEPILOT_JWT_SECRET=replace-with-a-long-random-secret
MOVIEPILOT_RESOURCE_SECRET=replace-with-another-long-random-secret
MOVIEPILOT_MASTER_KEY=replace-with-32-byte-or-longer-secret
MOVIEPILOT_BOOTSTRAP_USERNAME=admin
MOVIEPILOT_BOOTSTRAP_PASSWORD=change-me-now
MOVIEPILOT_FRONTEND_DIR=/app/web/dist
CONFIG_DIR=/config
APP_DOMAIN=
MOVIEPILOT_TIMEZONE=Asia/Shanghai
MOVIEPILOT_METADATA_WORKERS=12
MOVIEPILOT_METADATA_TIMEOUT=10s
MOVIEPILOT_METADATA_CACHE_TTL=12h
MOVIEPILOT_METADATA_MIN_INTERVAL=100ms
MOVIEPILOT_METADATA_MAX_BACKOFF=30s
MOVIEPILOT_METADATA_MAX_RESULTS=20
MOVIEPILOT_TMDB_TOKEN=
MOVIEPILOT_DOUBAN_API_KEY=
MOVIEPILOT_DOUBAN_SECRET_KEY=
MOVIEPILOT_BANGUMI_TOKEN=
